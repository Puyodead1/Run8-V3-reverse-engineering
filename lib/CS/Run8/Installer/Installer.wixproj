<Project Sdk="WixToolset.Sdk/5.0.0">
  <PropertyGroup>
    <OutputName>Run8Tools Installer</OutputName>
    <EnableProjectHarvesting>true</EnableProjectHarvesting>
    <HarvestProjectsVerboseOutput>true</HarvestProjectsVerboseOutput>
  </PropertyGroup>
  <ItemGroup>
    <HarvestDirectory Include="$(IntermediateOutputPath)\publish\TextureTool">
      <ComponentGroupName>TextureToolFiles</ComponentGroupName>
      <DirectoryRefId>TextureTool</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
  </ItemGroup>
  <ItemGroup>
    <HarvestDirectory Include="$(IntermediateOutputPath)\publish\ColladaConverter">
      <ComponentGroupName>ColladaConverterFiles</ComponentGroupName>
      <DirectoryRefId>ColladaConverter</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LibRun8\LibRun8.csproj" />
    <ProjectReference Include="..\RN8ToObj\ColladaConverter.csproj" Publish="true" />
    <ProjectReference Include="..\TextureTools\TextureTool.csproj" Publish="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="5.0.0" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="5.0.0" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.0" />
  </ItemGroup>
</Project>